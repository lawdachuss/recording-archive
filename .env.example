# ── REQUIRED: Chaturbate cookies (get these from your browser after logging in) ──
COOKIES="your_cookies_here"
USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36"

# ── Streamtape ──
STREAMTAPE_LOGIN="your_streamtape_login"
STREAMTAPE_API_KEY="your_streamtape_api_key"

# ── VOESX ──
VOESX_API_KEY="your_voesx_api_key"

# ── SendCM ──
SENDCM_API_KEY="your_sendcm_api_key"

# ── BYSE ──
BYSE_API_KEY="your_byse_api_key"

# ── Supabase ──
SUPABASE_URL="https://supabase.chuglii.in"
# Service role key (admin) for the API server — must match SUPABASE_SERVICE_ROLE_KEY
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key"
# Anon key for public access (used by API server when SERVICE_ROLE_KEY is not set)
SUPABASE_ANON_KEY="your_supabase_anon_key"
# Frontend (Vite) env vars — must be set at build time on Vercel
VITE_SUPABASE_URL="https://supabase.chuglii.in"
VITE_SUPABASE_ANON_KEY="your_supabase_anon_key"

# ── API URL (optional, for different-domain API) ──
# When set, all API calls are prefixed with this URL.
# Leave empty for same-origin requests (default).
# Example: VITE_API_URL="https://your-api.vercel.app"
VITE_API_URL=""

# ── Mixdrop ──
MIXDROP_EMAIL="your_mixdrop_email"
MIXDROP_KEY="your_mixdrop_key"

# ── Database ──
DATABASE_URL="***REMOVED***"

# ── Redis (caching) ──
# Priority: if REDIS_HTTP_URL is set, the API talks to the self-hosted Redis
# through the permanent HTTPS bridge (/functions/v1/redis-http) — works from
# Vercel serverless, no tunnel. REDIS_URL/TCP is used otherwise (co-located or
# via supabase-selfhosted/redis-tunnel.sh).
# REDIS_HTTP_URL="https://supabase.yourdomain.com/functions/v1/redis-http"
# REDIS_HTTP_KEY="<self-hosted SUPABASE_SERVICE_ROLE_KEY>"
REDIS_URL="***REMOVED***"

# ── FFmpeg Path (automatically detected) ──
FFMPEG_PATH="C:\path\to\ffmpeg.exe"

# ── Ports ──
PORT=8080
BASE_PATH="/"

# ── Cache warm cron ──
# Secret guarding the /api/cache/warm endpoint (Vercel Cron Jobs send
# `Authorization: Bearer <this>` automatically when CRON_SECRET is set).
# Generate one with: openssl rand -hex 24
CRON_SECRET="your_cron_secret_here"

# ── Ads & Premium ──
# Master switch for the ads subsystem. Set "true" (and configure a network /
# ad server) to start serving ads. Server-side kill-switch:
# site_settings.ads_enabled (see supabase/migrations/005-premium.sql).
VITE_ADS_ENABLED="false"
# Optional third-party ad loader tag executed inside every enabled slot.
VITE_AD_NETWORK_SCRIPT=""
# ExoClick placement: zone id written to data-zoneid on the <ins> tag.
# Enable both VITE_AD_NETWORK_SCRIPT and VITE_AD_ZONE_ID to actually serve.
VITE_AD_ZONE_ID="6031598"
# ExoClick placement class (the `eas...` tag issued to this account).
VITE_AD_CLASS="eas6a97888e2"
# Adsterra global placements (loaded once per session, gated by showAds):
# popunder script URL and social bar script URL from the Adsterra dashboard.
VITE_ADSTERRA_POPUNDER=""
VITE_ADSTERRA_SOCIALBAR=""
# Adsterra smartlink redirect URL (clickable sponsored strip on the home page).
VITE_ADSTERRA_SMARTLINK=""
# Adsterra iframe banner (atOptions + invoke.js) for the home leaderboard spot.
VITE_ADSTERRA_BANNER_KEY=""
VITE_ADSTERRA_BANNER_INVOKE=""
# Stripe Checkout for premium purchases. When unset the API returns
# 501 "not_configured" and admins grant premium manually via the admin panel.
STRIPE_SECRET_KEY=""
STRIPE_PRICE_ID=""
STRIPE_WEBHOOK_SECRET=""
